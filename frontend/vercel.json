{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/api/:path*" },
    { "source": "/media/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/media/:path*" },
    { "source": "/static/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/static/:path*" },
    { "source": "/public/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/public/:path*" },
    { "source": "/admin/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/admin/:path*" },
    { "source": "/lesson/:id/download-ppt/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/lesson/:id/download-ppt/:path*" },
    { "source": "/lesson/:id/watch-time/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/lesson/:id/watch-time/:path*" },
    { "source": "/certificate/:id/download-pdf/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/certificate/:id/download-pdf/:path*" },
    { "source": "/download-assignment-pdf/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/download-assignment-pdf/:path*" },
    { "source": "/notifications/read/:id/:path*", "destination": "https://YOUR-BACKEND.up.railway.app/notifications/read/:id/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
