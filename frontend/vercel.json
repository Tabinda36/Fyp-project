{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/media/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/static/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/public/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/admin/$1"
    },
    {
      "source": "/admin",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/admin/"
    },
    {
      "source": "/lesson/(\\d+)/download-ppt/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/lesson/$1/download-ppt/$2"
    },
    {
      "source": "/lesson/(\\d+)/watch-time/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/lesson/$1/watch-time/$2"
    },
    {
      "source": "/certificate/(\\d+)/download-pdf/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/certificate/$1/download-pdf/$2"
    },
    {
      "source": "/download-assignment-pdf/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/download-assignment-pdf/$1"
    },
    {
      "source": "/notifications/read/(\\d+)/(.*)",
      "destination": "https://fyp-project-production-82a56544.up.railway.app/notifications/read/$1/$2"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
