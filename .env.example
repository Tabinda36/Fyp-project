# Copy to .env (repository root) and fill in. Never commit .env.

# Required
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Development defaults shown; for production set DEBUG=False and real hosts/origins
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173

# Which UI serves page URLs: react (built SPA in frontend/dist) or templates (legacy Django templates)
ALVIX_FRONTEND=react

# Administrators are Django staff users: python manage.py grant_admin <email-or-username>

# Email (console backend prints signup verification codes in the runserver terminal)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=ALVIX <no-reply@alvix.local>
# Gmail SMTP: set the backend to django.core.mail.backends.smtp.EmailBackend,
# HOST_USER = the Gmail address, HOST_PASSWORD = a Google *App password* (16 letters, no spaces),
# and DEFAULT_FROM_EMAIL to e.g. ALVIX <your-address@gmail.com> (must be the same Gmail account).
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True

# Optional AI integrations (the app falls back to built-in content without them)
GEMINI_API_KEY=
YOUTUBE_API_KEY=

# Database: leave DB_HOST empty for local SQLite; for Supabase use the pooler host, port 6543 (transaction pooler)
DB_HOST=
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Supabase project API keys (secret key is server-side only)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Storage bucket for uploads; leave empty to keep uploads in backend/media/
SUPABASE_STORAGE_BUCKET=
SUPABASE_STORAGE_PUBLIC=True

# ---------------------------------------------------------------------------
# Production (Railway backend + Vercel frontend) — set these in Railway > Variables
# ---------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long random string>
# Your Vercel domain(s). The Railway domain is added automatically (RAILWAY_PUBLIC_DOMAIN).
# DJANGO_ALLOWED_HOSTS=localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# Uploads must go to Supabase Storage on Railway (its disk is wiped on every deploy):
# SUPABASE_URL / SUPABASE_SECRET_KEY / SUPABASE_STORAGE_BUCKET as above
# Optional gunicorn tuning: GUNICORN_WORKERS=2  GUNICORN_THREADS=4  GUNICORN_TIMEOUT=300
