{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(../.venv/Scripts/python.exe manage.py check*)",
      "Bash(../.venv/Scripts/python.exe manage.py test*)",
      "Bash(../.venv/Scripts/python.exe manage.py showmigrations*)",
      "Bash(../.venv/Scripts/python.exe manage.py makemigrations --check*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./backend/.env)",
      "Read(./backend/alvix/.env)",
      "Bash(git push --force*)",
      "Bash(*manage.py flush*)"
    ]
  }
}
